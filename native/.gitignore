# Build output — regenerated by every build, and large.
android/app/build/
android/build/
android/.gradle/
android/captures/
android/local.properties
android/app/src/main/assets/public/

# Never. It names the Firebase project and carries an API key, so it is a
# repository secret and the workflow writes it at build time.
android/app/google-services.json

# Never, under any circumstances. Whoever holds this can sign an update that
# Android will install over the real app.
*.keystore
*.jks
